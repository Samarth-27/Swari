# =================================================================
# Swari (सवारी) Environment Configuration Template
# SECURITY: Contains placeholders only. Never commit real credentials.
# =================================================================

# Server Network & Runtime
NODE_ENV=production
PORT=8000
HOST=0.0.0.0
CORS_ORIGIN=https://swari.in,https://app.swari.in
LOG_LEVEL=info

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://db_user_placeholder:db_password_placeholder@localhost:5432/swari_production

# Redis Cache & Real-Time Adapter (Redis 7)
REDIS_URL=redis://localhost:6379

# Authentication & Cryptographic Tokens (HMAC SHA-256 / Argon2id)
JWT_SECRET=placeholder_jwt_secret_min_32_characters_random_key
JWT_REFRESH_SECRET=placeholder_jwt_refresh_secret_min_32_characters_random_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Sentry Error Reporting (MOCK / Stub)
SENTRY_DSN=placeholder_sentry_dsn_https_key_ingest_sentry_io

# Prometheus Metrics
METRICS_ENABLED=true

# External Simulated Services (Marked MOCK in code and docs)
DIGILOCKER_API_KEY=mock_digilocker_sandbox_token
PARIVAHAN_API_KEY=mock_parivahan_dl_rc_token
ERSS_112_ENDPOINT=mock_police_erss_112_dispatch_endpoint
RAZORPAY_KEY_ID=mock_escrow_safepay_key_id
RAZORPAY_KEY_SECRET=mock_escrow_safepay_secret

# Statutory Legal Compliance Notice
# Legal Model: cost-sharing model designed to align with Motor Vehicles Act rules; needs legal review per state
LEGAL_FRAMEWORK_NOTE=cost-sharing model designed to align with Motor Vehicles Act rules; needs legal review per state
